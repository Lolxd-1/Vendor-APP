{
  "worktree": {
    "baseRef": "head",
    "symlinkDirectories": [
      "node_modules"
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash .claude/skills/orchestrate/scripts/orch.sh *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/orchestrate/scripts/orch.sh\" hook-pretool",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/orchestrate/scripts/orch.sh\" hook-session",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
