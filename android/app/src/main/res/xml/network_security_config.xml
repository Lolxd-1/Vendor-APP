<?xml version="1.0" encoding="utf-8"?>
<!-- The backend has no TLS yet: allow plain HTTP to it ONLY. Remove once it serves https/wss. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="false" />
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">prd.quickverse.in</domain>
  </domain-config>
</network-security-config>
